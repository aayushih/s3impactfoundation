---
layout: base.njk
title: Contact Us
permalink: /contact/
description: "Partnerships, questions and visits. Write to S3 Impact Foundation."
---
{%- set c = pages.contact -%}
{%- set ph = { title: c.title, intro: c.intro, label: "Contact us" } -%}
{% include "phero.njk" %}

<section class="wrap contact">
  <form class="cform rv" method="POST" action="https://api.web3forms.com/submit" id="contactForm">
    <input type="hidden" name="access_key" value="{{ site.contact.form_key }}">
    <input type="hidden" name="subject" value="New message from the {{ site.name }} website">
    <input type="hidden" name="from_name" value="{{ site.name }} website">
    <input type="hidden" name="redirect" value="" data-thanks="/contact/thanks/">
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    {% if not site.contact.form_key %}<p class="formnote">The form will be switched on shortly. Until then, please use the details beside it.</p>{% endif %}
    <div class="row2">
      <label>Name<input name="name" type="text" autocomplete="name" required></label>
      <label><span>Organisation <small>(optional)</small></span><input name="organisation" type="text" autocomplete="organization"></label>
    </div>
    <label>Email<input name="email" type="email" autocomplete="email" required></label>
    <label>I am interested in
      <select name="interest" id="interest">
        {% for i in c.interests %}<option value="{{ i.value }}">{{ i.label }}</option>{% endfor %}
      </select>
    </label>
    <label>Message<textarea name="message" rows="6" required></textarea></label>
    <button class="btn ink" type="submit"{% if not site.contact.form_key %} disabled{% endif %}>{{ c.button }} <span class="arr">→</span></button>
  </form>
  <aside class="cdetails rv" style="--d:.15s">
    <div><p class="lab">Visit</p><p>{{ site.contact.address }}</p></div>
    <div><p class="lab">Email</p><p>{% if site.contact.email %}<a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% else %}<span class="pending">To be added</span>{% endif %}</p></div>
    <div><p class="lab">Phone</p><p>{% if site.contact.phone %}<a href="{{ site.contact.phone | tel }}">{{ site.contact.phone }}</a>{% else %}<span class="pending">To be added</span>{% endif %}</p></div>
  </aside>
</section>
